# Public build-time settings; never put secrets in VITE_ variables.
# Defaults already use the details supplied for this project.
VITE_SITE_URL=https://execordus.org
VITE_LEGAL_OPERATOR=Dimitrii Grinciuc
VITE_PRIVACY_EMAIL=earlyaccess@execordus.org
# Optional, if a business/mailing address should appear in the privacy notice.
VITE_LEGAL_ADDRESS=
# Official HTTPS desktop application, release, or installer destination.
# Until supplied, Desktop app opens /desktop/ with an early-access email link.
VITE_DESKTOP_APP_URL=
# Set false on staging deployments. Set VITE_SITE_URL blank for an unbranded-origin preview.
VITE_SITE_INDEXABLE=true
